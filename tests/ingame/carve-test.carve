# Test script for tests/ingame/run.js. Every message starts with "t:" so the
# runner can tell it apart from the example scripts.
on join:
    send "t:join %player%" to player
    send title "t:title" with subtitle "t:sub" to player
    send action bar "t:bar" to player
    wait 1 second
    send "t:waited %player%" to player
    cancel event

on quit:
    broadcast "t:quit %player%"

on chat:
    if message is "blockme":
        cancel event
        send "t:blocked %message%" to player

on break:
    send "t:break" to player
    cancel event

on place:
    send "t:place" to player

command /tperm <text>:
    permission: tperm
    trigger:
        send "t:arg %arg-1%"

command /thealth:
    trigger:
        set health of player to 7
        send "t:health-set"

command /theal:
    trigger:
        heal player
        send "t:healed"

command /ttp:
    trigger:
        teleport player to 10, 100, 10
        send "t:tp"

command /tvar:
    trigger:
        add 1 to {t_counter}
        send "t:counter %{t_counter}%"

command /tconsole:
    trigger:
        execute console command "say t:console"

# ---- v2 ----
options:
    tp: t:

on load:
    set {t_loaded} to "yes"

every 1 second:
    add 1 to {t_beats}

function double(n: number) :: number:
    return {_n} * 2

function later(p: player):
    wait 5 ticks
    send "t:fwait" to {_p}

command /tloop:
    trigger:
        loop all players:
            add name of loop-player to {_names::*}
        send "{@tp}loop %size of {_names::*}%"
        loop 3 times:
            add loop-number to {_sum}
        send "t:sum %{_sum}%"

command /tcond:
    trigger:
        if 5 is between 1 and 9 and "Hello" contains "ELL":
            if player is "nobody" or player is "Tester":
                if name of player is "x", "y" or "Tester":
                    send "t:cond ok"

command /tfunc:
    trigger:
        send "t:func %double(21)%"
        later(player)

command /tstate:
    trigger:
        send "t:loaded %{t_loaded}% beats %{t_beats}%"

command /titem:
    trigger:
        give 3 diamonds to player
        wait 10 ticks
        if player has 3 diamonds:
            send "t:has diamonds"
        send "t:tool %tool of player%"

command /tloc:
    trigger:
        send "t:loc %x of player% %y of player% %z of player% %world of player%"
        teleport player to location(5, 90, 5)

on damage of player:
    send "t:dmg %damage% by %attacker%" to victim

on death:
    send "t:died" to player

on respawn:
    send "t:respawned" to player

on right click:
    send "t:rclick %clicked block%" to player

on left click with stone:
    send "t:lclick-stone" to player

# ---- gaps: inventory values, held items, misc ----
command /tgui:
    trigger:
        set {t_gui} to chest inventory with 3 rows named "Shop"
        set slot 4 of {t_gui} to diamond named "&bBuy"
        set slot 5 of {t_gui} to 2 emeralds
        open {t_gui} to player
        set slot 6 of {t_gui} to gold ingot
        send "t:gui %name of {t_gui}% %size of items in {t_gui}%" to player

on inventory click:
    if name of event-inventory is "Shop":
        cancel event
        if event-inventory is {t_gui}:
            send "t:guiclick %clicked slot% %slot 6 of event-inventory% %clicked item%" to player

command /theld:
    trigger:
        set name of player's tool to "Blade"
        set lore of player's tool to "line a" and "line b"
        add "line c" to lore of player's tool
        enchant player's tool with sharpness 5
        send "t:held %name of player's tool%|%lore of player's tool%|%enchantments of player's tool%" to player
        disenchant player's tool
        send "t:held2 [%enchantments of player's tool%] %size of items in player's inventory%" to player

command /tmisc:
    trigger:
        set {_l::*} to "ccc", "a" and "bb"
        set {_t} to 2 minutes and 30 seconds
        set {_x} to "a1b22"
        replace all regex "[0-9]+" in {_x} with "#"
        send "t:misc %sorted {_l::*} by length of input% %{_t}'s minutes% %{_x}% <%rgb(255, 0, 0)%>red" to player
        send "t:doif" to player if 1 is 1
        filter {_l::*} to match:
            input is "a"
        send "t:filter %{_l::*}%" to player
        play dust particles at player with color rgb(0, 255, 0)

command /tmob:
    trigger:
        spawn a zombie named "Bob" at location(4, 64, 0.5)
        set {_z} to last spawned entity
        set velocity of {_z} to vector(0, 0.5, 0)
        send "t:mob %name of {_z}% %y velocity of {_z}%" to player
        push {_z} away from player with speed 1
        send "t:mobpush %x velocity of {_z}%" to player
        set velocity of player to vector(0, 0.42, 0)
        send "t:pvel %y velocity of player%" to player
        set velocity of player to vector(0, 0, 0)
        push player forward with speed 1
        send "t:pfwd %x velocity of player% %z velocity of player%" to player

on death of zombie:
    broadcast "t:mobdeath %victim% %name of victim%"

on quit:
    set quit message to "t:bye %player%"

on chat:
    if message is "tcancel":
        cancel event
        if event is cancelled:
            send "t:cancelled" to player
