# In-game checks for the parsing, loot and item-component syntax (tests/ingame/areas/parsing-loot-components.js).

command /plcparse:
    trigger:
        send "pa:%"12" parsed as integer%|%"1.5" parsed as integer%|%"yes" parsed as boolean%|%"maybe" parsed as boolean%|%"Tester" parsed as player%|%"Nobody" parsed as player%"

command /plcfmt:
    trigger:
        set {_t} to 65 minutes
        send "fm:%{_t} formatted human-readable%|%{_t} formatted%"

command /plckey:
    trigger:
        send "ky:%key of diamond%|%key of loot table from key "chests/simple_dungeon"%|%key of loot table from key "mymod:stuff"%"

command /plcloot:
    trigger:
        set {_c} to loot context at location(1, 64, 2) with luck 3 with looter player
        send "lc:%loot location of {_c}%|%loot luck of {_c}%|%looter of {_c}%|%looted entity of {_c}%"

command /plcstack:
    trigger:
        send "st:%max stack size of ender pearl%|%max stack size of diamond sword%|%max stack size of cobblestone%|%max stack size of egg%"

command /plcitem:
    trigger:
        give diamond sword with custom model data 7 to player
        send "it:%custom model data of player's tool%|%player's tool%|%item model of player's tool%"

command /plcitem2:
    trigger:
        set {_i} to stick with enchantment glint true
        set {_j} to stick with item model "minecraft:blaze_rod"
        give {_i} to player
        give {_j} to player
        send "it2:given"

command /plcread:
    trigger:
        send "rd:%glint override of player's tool%|%item model of player's tool%"

command /plcmisc:
    trigger:
        send "hx:%hex code of "red"%|%hex code of "#00ff7f"%"
        
        send "id:%id of diamond%"
        send "hs:%highest solid block at location(0, 64, 0)%"
        send "mo:%motd%"
