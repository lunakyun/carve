# Wave 6 chunk 7 area: variadic min/max, round(n, places), world("x"),
# entity(uuid), axisAngle, `for each`, alias patterns and plurals, and the
# accepted-and-ignored `locally suppress` / `using` lines.
# Every command reports back with a "c7:" message the test reads.

using skript-reflect

aliases:
    my (fast|quick) blade = diamond sword
    pebble = cobblestone

command /c7math:
    trigger:
        send "c7:math %max(1, 9, 4)% %min(5, 3, 8, 2)% %round(3.14159, 2)% %round(2.5)% %max(2, 7)%" to player

command /c7world:
    trigger:
        send "c7:world %world("world")%" to player

command /c7entity:
    trigger:
        spawn a pig at location(3, 100, 3)
        set {_u} to uuid of last spawned entity
        set {_e} to entity({_u})
        send "c7:entity %type of {_e}% %type of (entity from uuid {_u})%" to player

command /c7player:
    trigger:
        send "c7:player %entity(uuid of player)%" to player

command /c7axis:
    trigger:
        set {_q} to axisAngle(180, 0, 2, 0)
        set {_r} to axisAngle(90, vector(1, 0, 0))
        send "c7:axis %{_q}% %{_r}%" to player

command /c7each:
    trigger:
        set {_l::*} to 1, 2 and 3
        set {_s} to ""
        for each {_x} in {_l::*}:
            set {_s} to "%{_s}%%{_x}%,"
        send "c7:each %{_s}%" to player

command /c7alias:
    trigger:
        give 1 of my quick blade to player
        give 2 pebbles to player
        send "c7:alias" to player

command /c7suppress:
    trigger:
        locally suppress conflict warnings
        send "c7:suppress" to player
