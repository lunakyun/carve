# Wave 6 chunk 4 area: first/last/range elements, dequeue, banner pattern
# items, persistent data keys, honey level, brushing stage and block age.
# Every command reports back with a "w6:" message the test reads.

command /w6pad:
    trigger:
        set block at location(0, 99, 0) to stone
        set block at location(1, 99, 0) to stone
        send "w6:pad" to player

command /w6elements:
    trigger:
        set {w6::*} to 1, 2, 3, 4, 5
        send "w6:elements %first 2 elements of {w6::*}%|%last 2 elements of {w6::*}%|%elements 2 to 4 of {w6::*}%|%size of first 3 elements of {w6::*}%"
        delete {w6::*}

command /w6queue:
    trigger:
        set {_q} to a new queue of "a", "b", "c", "d"
        set {_x} to dequeue {_q}
        set {_y::*} to dequeue first 2 elements of {_q}
        set {_z} to de-queue {_q}
        set {_none} to dequeue {_q}
        send "w6:queue %{_x}% %{_y::1}%%{_y::2}% %{_z}% %{_none}%"

command /w6banner:
    trigger:
        give 1 of banner pattern item of "flower" to player
        send "w6:banner %banner pattern item of ""creeper""% %banner pattern item of ""stripe_top""%"

command /w6keys:
    trigger:
        set persistent data value "w6zeta" of player to 1
        set persistent data value "w6alpha" of player to "x"
        send "w6:keys %persistent data keys of player%"
        delete persistent data value "w6zeta" of player
        delete persistent data value "w6alpha" of player
        send "w6:keys2 %size of all persistent data keys of player%"

command /w6honey:
    trigger:
        set block at location(6, 100, 6) to beehive
        send "w6:honey0 %honey level of location(6, 100, 6)% %max honey level of location(6, 100, 6)%"
        set honey level of location(6, 100, 6) to 4
        add 9 to honey level of location(6, 100, 6)
        send "w6:honey1 %honey level of location(6, 100, 6)%"
        remove 2 from honey level of location(6, 100, 6)
        send "w6:honey2 %beehive honey level of location(6, 100, 6)%"
        reset honey level of location(6, 100, 6)
        send "w6:honey3 %honey level of location(6, 100, 6)%"
        set honey level of location(6, 100, 6) to 5

command /w6brush:
    trigger:
        set block at location(7, 100, 6) to suspicious sand
        send "w6:brush0 %brushing stage of location(7, 100, 6)% %max brushing stage of location(7, 100, 6)%"
        set brushing stage of location(7, 100, 6) to 2
        send "w6:brush1 %brushing progress of location(7, 100, 6)%"

command /w6age:
    trigger:
        set block at location(8, 100, 6) to wheat
        send "w6:age0 %age of location(8, 100, 6)% %max age of location(8, 100, 6)%"
        add 3 to age of location(8, 100, 6)
        send "w6:age1 %age of location(8, 100, 6)%"
        set age of location(8, 100, 6) to 99
        send "w6:age2 %age of location(8, 100, 6)%"
        set block at location(9, 100, 6) to stone
        send "w6:age3 %age of location(9, 100, 6)%"
