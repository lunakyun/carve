# Wave 5 chunk 6 area: scale, targets, the spectator camera, text displays,
# sea pickles, block data, temperature, world border warnings, boss bar and
# inventory reads, all <type>s, slot index, spawn eggs, stored enchantments,
# the shoot section and event value names.
# Every command reports back with a "c6:" message the test reads.

command /c6pad:
    trigger:
        set block at location(0, 99, 0) to stone
        set block at location(1, 99, 0) to stone
        set block at location(2, 99, 0) to stone
        set block at location(0, 99, 1) to stone
        set block at location(1, 99, 1) to stone
        set block at location(2, 99, 1) to stone
        send "c6:pad" to player

command /c6border:
    trigger:
        send "c6:border %world border of player%" to player
        set world border warning distance to 12
        set world border warning time of player's world border to 30 seconds
        send "c6:warn %world border warning distance% %world border warning time%" to player

command /c6pickle:
    trigger:
        set block at location(6, 100, 6) to sea pickle
        set sea pickles of location(6, 100, 6) to 3
        send "c6:pickles %sea pickles of location(6, 100, 6)% %max pickles of location(6, 100, 6)%" to player

command /c6data:
    trigger:
        set block data of location(7, 100, 6) to "oak_log[axis=z]"
        send "c6:data %block data of location(7, 100, 6)%" to player

command /c6temp:
    trigger:
        send "c6:temp %biome of player% %temperature of block below player%" to player

command /c6scale:
    trigger:
        set scale of player to 2
        send "c6:scale %scale of player%" to player

command /c6unscale:
    trigger:
        reset scale of player
        send "c6:unscale %player's scale%" to player

command /c6target:
    trigger:
        spawn a zombie at location(3, 100, 3)
        set {c6::zombie} to last spawned entity
        set target of last spawned entity to player
        send "c6:target %target of last spawned entity%" to player

command /c6spec:
    trigger:
        spawn a pig at location(-3, 100, 3)
        set spectator target of player to last spawned entity
        send "c6:spec %type of spectator target of player%" to player

command /c6unspec:
    trigger:
        reset spectator target of player
        send "c6:unspec %spectator target of player%" to player

command /c6td:
    trigger:
        spawn text display at location(0, 102, 3) with text "hello"
        set {_d} to last spawned entity
        set text alignment of {_d} to left
        set line width of {_d} to 80
        set text opacity of {_d} to 128
        set scale of {_d} to vector(2, 2, 2)
        send "c6:td %text alignment of {_d}% %line width of {_d}% %{_d}'s text opacity% %scale of {_d}%" to player

command /c6bar:
    trigger:
        create bossbar "c6" with title "Raid" with style notched 10 with progress 50
        add player to viewers of bossbar "c6"
        send "c6:bar %title of bossbar "c6"% %style of bossbar "c6"% %viewers of bossbar "c6"%" to player

command /c6inv:
    trigger:
        set {_i} to chest inventory with 3 rows named "Shop"
        set title of {_i} to "Bank"
        add player to viewers of {_i}
        send "c6:inv %title of {_i}% %viewers of {_i}%" to player

command /c6all:
    trigger:
        loop all difficulties:
            add loop-value to {_d::*}
        send "c6:all %{_d::*}%" to player

command /c6egg:
    trigger:
        set {_e} to 1 zombie spawn egg
        send "c6:egg %spawn egg entity of {_e}%" to player
        set spawn egg entity of {_e} to cow
        give {_e} to player
        send "c6:egg2 %{_e}%" to player

command /c6stored:
    trigger:
        set stored enchantments of player's tool to "sharpness 5"
        send "c6:stored %stored enchantments of player's tool%" to player

command /c6slot:
    trigger:
        send "c6:slot %index of slot 5 of player's inventory%" to player

command /c6shoot:
    trigger:
        shoot an arrow from player at speed 2:
            send "c6:shot %type of event-entity%" to player

command /c6hints:
    trigger:
        suppress type hints:
            send "c6:hints ok" to player

on spawn:
    if "%event-entity%" is "cow":
        broadcast "c6:reason %spawning reason%"

on tame:
    broadcast "c6:tamer %tamer%"

on spread:
    broadcast "c6:source %type of source block%"

on shoot:
    broadcast "c6:shooter %shooter%"

