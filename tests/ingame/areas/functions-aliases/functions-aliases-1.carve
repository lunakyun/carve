# Wave 6 chunk 7 area: variadic min/max, round(n, places), world("x"),
# entity(uuid), axisAngle, `for each`, alias patterns and plurals, and the
# accepted-and-ignored `locally suppress` / `using` lines.
# Every command reports back with a "fal:" message the test reads.

using skript-reflect

aliases:
    my (fast|quick) blade = diamond sword
    pebble = cobblestone

command /falmath:
    trigger:
        send "fal:math %max(1, 9, 4)% %min(5, 3, 8, 2)% %round(3.14159, 2)% %round(2.5)% %max(2, 7)%" to player

command /falworld:
    trigger:
        send "fal:world %world("world")%" to player

command /falentity:
    trigger:
        spawn a pig at location(3, 100, 3)
        set {_u} to uuid of last spawned entity
        set {_e} to entity({_u})
        send "fal:entity %type of {_e}% %type of (entity from uuid {_u})%" to player

command /falplayer:
    trigger:
        send "fal:player %entity(uuid of player)%" to player

command /falaxis:
    trigger:
        set {_q} to axisAngle(180, 0, 2, 0)
        set {_r} to axisAngle(90, vector(1, 0, 0))
        send "fal:axis %{_q}% %{_r}% %quaternion(1, 0, 2, 0)%" to player

command /faleach:
    trigger:
        set {_l::*} to 1, 2 and 3
        set {_s} to ""
        for each {_x} in {_l::*}:
            set {_s} to "%{_s}%%{_x}%,"
        send "fal:each %{_s}%" to player

command /falalias:
    trigger:
        give 1 of my quick blade to player
        give 2 pebbles to player
        send "fal:alias" to player

command /falsuppress:
    trigger:
        locally suppress conflict warnings
        send "fal:suppress" to player

command /falicon:
    trigger:
        load the server icon from file "icon.png"
        send "fal:icon" to player


on server list ping:
    set the server icon to the last loaded server icon

function falany(a: any named thing, b: any numbered thing, c: any sized thing, d: any valued thing, e: anything with contents, f: audience, g: metadata holder, h: nameable, i: entity, j: gamerule value, k: item type, l: vector) :: text:
    return "types-ok"

command /faltypes:
    trigger:
        send "fal:types %falany(player, 5, "abc", 3, player, player, player, player, player, true, diamond sword, vector(1, 2, 3))%" to player

command /falteam:
    trigger:
        register team "falt"
        set death message visibility of team "falt" to hide for other teams
        send "fal:team %team death message visibility of ""falt""%" to player
