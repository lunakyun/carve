# Wave 6 chunk 2 area. Every result goes to chat as w2:<key> <value>.

command /w2ping:
    trigger:
        send "w2:ping" to player

command /w2horn:
    trigger:
        spawn a goat at location(3, 101, 3)
        set {goat} to last spawned entity
        remove the left horn of {goat}
        send "w2:horn" to player

command /w2horn2:
    trigger:
        remove {goat}'s right horn
        send "w2:horn2" to player

command /w2horn3:
    trigger:
        regrow both horns of {goat}
        send "w2:horn3" to player

command /w2silent:
    trigger:
        spawn a cow at location(9, 101, 3)
        set {cow} to last spawned entity
        silence {cow}
        send "w2:silent" to player

command /w2silent2:
    trigger:
        unsilence {cow}
        send "w2:silent2" to player

command /w2scream:
    trigger:
        make {goat} scream
        send "w2:scream" to player

command /w2tree:
    trigger:
        grow oak at location(30, 101, 30)
        send "w2:tree" to player

command /w2treeat:
    trigger:
        set {_n} to 0
        loop 6 times:
            if "%type of block at location(30, 100 + loop-number, 30)%" contains "log":
                add 1 to {_n}
        send "w2:treeat %{_n}%" to player

command /w2zomb0:
    trigger:
        spawn a villager at location(12, 101, 3)
        set {v} to last spawned entity
        set name of {v} to "Bob"
        send "w2:zomb0 %name of {v}% %health of {v}%" to player

command /w2zomb:
    trigger:
        zombify {v}
        send "w2:zomb" to player

command /w2allay:
    trigger:
        spawn an allay at location(15, 102, 3)
        set {allay} to last spawned entity
        make {allay} duplicate
        send "w2:allay" to player

command /w2dis:
    trigger:
        disable script "w6c2b"
        send "w2:dis" to player

command /w2en:
    trigger:
        enable script "w6c2b"
        send "w2:en" to player

command /w2rel:
    trigger:
        reload script "w6c2b"
        send "w2:rel" to player

command /w2reset:
    trigger:
        set {_n} to 5
        set {_t} to "hi"
        set {_b} to true
        set {_l::*} to 1, 2, 1 and 3
        reset {_n}
        reset {_t}
        reset {_b}
        remove all 1 from {_l::*}
        send "w2:reset %{_n}%|%{_t}%|%{_b}%|%{_l::*}%" to player
        reset {_l::*}
        send "w2:reset2 %size of {_l::*}%" to player

command /w2rot:
    trigger:
        set {_v} to vector(1, 0, 0)
        rotate {_v} around the z-axis by 90
        set {_w} to vector(0, 0, 1)
        rotate {_w} around vector(0, 1, 0) by 90
        set {_l::1} to vector(0, 1, 0)
        set {_l::2} to vector(0, 0, 1)
        rotate {_l::*} around the x axis by 90
        send "w2:rot %{_v}%|%{_w}%|%{_l::1}%|%{_l::2}%" to player

command /w2warn:
    trigger:
        locally suppress conflict warnings
        suppress type hints:
            send "w2:warn body ran" to player

command /w2fly:
    trigger:
        allow flight for player
        send "w2:fly" to player

command /w2nofly:
    trigger:
        disallow flight for player
        send "w2:nofly" to player

command /w2fake:
    trigger:
        make player see location(5, 101, 5) as diamond_block
        send "w2:fake" to player

command /w2unfake:
    trigger:
        make player see location(5, 101, 5) as original block
        send "w2:unfake" to player

command /w2inter:
    trigger:
        spawn an interaction at location(24, 101, 5)
        set {inter} to last spawned entity
        make {inter} responsive
        set {_a} to "no"
        if {inter} is responsive:
            set {_a} to "yes"
        send "w2:inter %{_a}%" to player

command /w2inter2:
    trigger:
        make {inter} unresponsive
        set {_a} to "no"
        if {inter} is responsive:
            set {_a} to "yes"
        send "w2:inter2 %{_a}%" to player

command /w2td:
    trigger:
        spawn text display at location(0, 102, 6) with text "hi"
        set {td} to last spawned entity
        remove drop shadow from {td}
        make {td} visible through blocks
        send "w2:td" to player

command /w2td2:
    trigger:
        apply drop shadow to {td}
        prevent {td} from being visible through blocks
        send "w2:td2" to player

command /w2stop:
    trigger:
        stop sound "entity.cow.ambient" in music for player
        send "w2:stop" to player

command /w2stopall:
    trigger:
        stop all sounds in master for player
        send "w2:stopall" to player

command /w2sheep:
    trigger:
        spawn a sheep at location(18, 101, 3)
        set {sheep} to last spawned entity
        shear {sheep}
        send "w2:sheep" to player

command /w2sheep2:
    trigger:
        unshear {sheep}
        send "w2:sheep2" to player

command /w2tame:
    trigger:
        spawn a wolf at location(21, 101, 3)
        set {wolf} to last spawned entity
        tame {wolf}
        send "w2:tame" to player

command /w2untame:
    trigger:
        untame {wolf}
        send "w2:untame" to player

command /w2ban:
    trigger:
        ban "Pleb" because of "w2 test" for 2 minutes
        send "w2:ban" to player

command /w2ride:
    trigger:
        spawn a pig at location(3, 101, 9)
        set {pig} to last spawned entity
        spawn a zombie at location(3, 101, 9)
        set {z2} to last spawned entity
        make {z2} ride {pig}
        send "w2:ride" to player

command /w2dismount:
    trigger:
        make {z2} dismount
        send "w2:dismount" to player

command /w2swing:
    trigger:
        make {z2} swing main hand
        send "w2:swing" to player

command /w2swing2:
    trigger:
        make {z2} swing off hand
        send "w2:swing2" to player

command /w2equip:
    trigger:
        equip {z2} with diamond helmet and iron boots
        send "w2:equip" to player

command /w2world:
    trigger:
        create world "w6test" with environment nether
        send "w2:world" to player

command /w2worldchk:
    trigger:
        set {_a} to "no"
        if world "w6test" is loaded:
            set {_a} to "yes"
        send "w2:worldchk %{_a}% %all worlds%" to player

command /w2world2:
    trigger:
        unload world "w6test"
        set {_a} to "no"
        if world "w6test" is loaded:
            set {_a} to "yes"
        send "w2:world2 %{_a}%" to player

command /w2bar:
    trigger:
        create bossbar "w2bar" with title "k" with color red
        add darken sky flag to bossbar "w2bar"
        set {_r} to ""
        if bossbar "w2bar" has darken sky flag:
            set {_r} to "dark"
        if bossbar "w2bar" has fog flag:
            set {_r} to "%{_r}%,fog"
        remove bossbar "w2bar"
        send "w2:bar %{_r}%" to player
